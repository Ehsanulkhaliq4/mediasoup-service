# ========================================================
# Mediasoup Zoom Conference Service Environment Config
# ========================================================

# HTTP / Server Configuration
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# Mediasoup Worker Settings
MEDIASOUP_NUM_WORKERS=4
MEDIASOUP_LOG_LEVEL=warn

# Network Ports for WebRTC RTP/RTCP Media Transmission
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# IP Configuration
# Local dev: 127.0.0.1
# Production: Set MEDIASOUP_ANNOUNCED_IP to your public Cloud/VPS IP (e.g. 54.123.45.67)
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
